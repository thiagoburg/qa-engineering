{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskflow-qa-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskflow-qa-lab-production",
      "database_id": "05c42613-8289-448b-804f-61b87afab1b4",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "taskflow-qa-lab-preview",
        "database_id": "40578af1-2afb-44c7-99e8-5da6b3127582",
        "migrations_dir": "migrations"
      }
    ]
  },
  "env": {
    "preview": {
      "name": "taskflow-qa-lab-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "taskflow-qa-lab-preview",
          "database_id": "40578af1-2afb-44c7-99e8-5da6b3127582",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}



